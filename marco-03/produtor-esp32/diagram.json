{
  "version": 1,
  "author": "Grupo Nao de nem agua",
  "editor": "wokwi",
  "parts": [
    { "id": "esp", "type": "board-esp32-devkit-c-v4", "top": 0, "left": 0, "attrs": {} },
    {
      "id": "pot1",
      "type": "wokwi-potentiometer",
      "top": -70,
      "left": 280,
      "attrs": { "value": "600" }
    },
    {
      "id": "ledBomba",
      "type": "wokwi-led",
      "top": 100,
      "left": 290,
      "attrs": { "color": "blue", "label": "Bomba" }
    },
    { "id": "r1", "type": "wokwi-resistor", "top": 110, "left": 360, "attrs": { "value": "220" } },
    {
      "id": "ledStatus",
      "type": "wokwi-led",
      "top": 180,
      "left": 290,
      "attrs": { "color": "green", "label": "Conectado" }
    },
    { "id": "r2", "type": "wokwi-resistor", "top": 190, "left": 360, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:34", "green", [] ],

    [ "esp:26", "r1:1", "blue", [] ],
    [ "r1:2", "ledBomba:A", "blue", [] ],
    [ "ledBomba:C", "esp:GND.2", "black", [] ],

    [ "esp:25", "r2:1", "green", [] ],
    [ "r2:2", "ledStatus:A", "green", [] ],
    [ "ledStatus:C", "esp:GND.2", "black", [] ]
  ],
  "serialMonitor": { "display": "always", "newline": "lf" }
}
