{
  "version": 1,
  "author": "Matheus Vieira Mendes Pacheco",
  "editor": "wokwi",
  "parts": [
    { "id": "esp", "type": "board-esp32-devkit-c-v4", "top": 0, "left": 0, "attrs": {} },
    { "id": "ldr1", "type": "wokwi-photoresistor-sensor", "top": -100, "left": 280, "attrs": { "lux": "500" } },
    { "id": "dht1", "type": "wokwi-dht22", "top": -20, "left": 280, "attrs": { "temperature": "29.8", "humidity": "41" } },
    { "id": "btn1", "type": "wokwi-pushbutton", "top": 70, "left": 300, "attrs": { "color": "yellow" } },
    { "id": "led1", "type": "wokwi-led", "top": 160, "left": 280, "attrs": { "color": "green" } },
    { "id": "r1", "type": "wokwi-resistor", "top": 170, "left": 340, "attrs": { "value": "220" } },
    { "id": "buzzer1", "type": "wokwi-buzzer", "top": 160, "left": 400, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ldr1:VCC", "esp:3V3", "red", [] ],
    [ "ldr1:GND", "esp:GND.1", "black", [] ],
    [ "ldr1:AO", "esp:35", "green", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.2", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],
    [ "btn1:1.l", "esp:27", "green", [] ],
    [ "btn1:2.l", "esp:3V3", "red", [] ],
    [ "led1:A", "r1:1", "green", [] ],
    [ "r1:2", "esp:26", "green", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ],
    [ "buzzer1:2", "esp:25", "green", [] ],
    [ "buzzer1:1", "esp:GND.3", "black", [] ]
  ]
}
