{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naodenemagua/v1/alerta-cuidado",
  "title": "AlertaCuidado v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "producerId", "entityId", "alertType", "severity", "message", "correlationId", "issuedAt", "ttlMs"],
  "properties": {
    "assinatura": {
      "type": "string",
      "pattern": "^[0-9a-f]{120,150}$",
      "description": "Marco 4: assinatura ECDSA P-256/SHA-256 do servico (DER em hex) sobre topico + \"\\n\" + corpo. Sempre o ULTIMO campo do JSON. O app confere com a chave publica do servico; no broker publico, mensagem sem assinatura valida e descartada."
    },
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "AlertaCuidado" },
    "producerId": { "const": "servico-irrigacao" },
    "entityId": { "type": "string", "minLength": 1 },
    "alertType": { "enum": ["SOLO_SECO", "IRRIGACAO_EXECUTADA", "IRRIGACAO_RECUSADA", "DADO_OBSOLETO", "DISPOSITIVO_OFFLINE", "DISPOSITIVO_RECUPERADO", "RESERVATORIO_BAIXO", "RESERVATORIO_CRITICO", "RESERVATORIO_NORMALIZADO", "SENSOR_FALHOU", "SENSOR_RECUPERADO", "FALHA_IRRIGACAO", "UMIDIFICADOR_ACIONADO", "ADUBACAO_EXECUTADA", "FALHA_ADUBACAO", "EXCESSO_NUTRIENTES", "ATUACAO_RECUSADA", "LUZ_INSUFICIENTE", "LUZ_EXCESSIVA", "LUZ_NORMALIZADA"] },
    "severity": { "enum": ["INFO", "ATENCAO", "CRITICO"] },
    "message": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string", "format": "utc-date-time" },
    "ttlMs": { "type": "integer", "minimum": 1 }
  }
}
