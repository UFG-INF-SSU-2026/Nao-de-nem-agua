# Modelo do arquivo .env (NAO contem segredos). O .env real e gerado por
# `npm run seguranca` com senhas aleatorias e nunca vai para o Git.
#
# Administrador do PostgreSQL -- so para operacao (npm run banco:psql).
POSTGRES_PASSWORD=
# Papel do servico-irrigacao (dono do schema naodenemagua).
PERSISTENCIA_SENHA_SERVICO=
# Papel somente leitura reservado para a API do aplicativo.
PERSISTENCIA_SENHA_LEITOR=
# Opcional: porta local do banco (padrao 5432).
# PERSISTENCIA_PORTA=5432
